<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Audit LSA & APAR</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen font-sans">
    <div class="max-w-3xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
        <div class="bg-white shadow-lg rounded-lg px-8 py-6">
            <h1 class="text-2xl font-bold text-gray-800 mb-2">Sistem Audit Dokumen Kapal</h1>
            <p class="text-gray-600 mb-6 text-sm">Unggah file Sertifikat Inspeksi dan Penawaran Vendor untuk melakukan rekonsiliasi data.</p>

            <form id="auditForm" class="space-y-6">
                <!-- Input Sertifikat -->
                <div>
                    <label class="block text-sm font-medium text-gray-700">1. Dokumen Sertifikat (Laporan Servis)</label>
                    <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-md hover:border-blue-500 transition-colors">
                        <div class="space-y-1 text-center">
                            <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48" aria-hidden="true">
                                <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            <div class="flex text-sm text-gray-600 justify-center">
                                <label for="file_sertifikat" class="relative cursor-pointer bg-white rounded-md font-medium text-blue-600 hover:text-blue-500 focus-within:outline-none">
                                    <span>Pilih File PDF</span>
                                    <input id="file_sertifikat" name="sertifikat" type="file" accept=".pdf" class="sr-only" required>
                                </label>
                            </div>
                            <p class="text-xs text-gray-500" id="name_sertifikat">Belum ada file dipilih</p>
                        </div>
                    </div>
                </div>

                <!-- Input Penawaran -->
                <div>
                    <label class="block text-sm font-medium text-gray-700">2. Dokumen Penawaran (Invoice/Quotation)</label>
                    <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-md hover:border-blue-500 transition-colors">
                        <div class="space-y-1 text-center">
                            <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48" aria-hidden="true">
                                <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            <div class="flex text-sm text-gray-600 justify-center">
                                <label for="file_penawaran" class="relative cursor-pointer bg-white rounded-md font-medium text-blue-600 hover:text-blue-500 focus-within:outline-none">
                                    <span>Pilih File PDF</span>
                                    <input id="file_penawaran" name="penawaran" type="file" accept=".pdf" class="sr-only" required>
                                </label>
                            </div>
                            <p class="text-xs text-gray-500" id="name_penawaran">Belum ada file dipilih</p>
                        </div>
                    </div>
                </div>

                <!-- Input URL Webhook n8n -->
                <div>
                    <label for="webhook_url" class="block text-sm font-medium text-gray-700">Webhook URL (n8n)</label>
                    <input type="url" id="webhook_url" name="webhook_url" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm" value="https://n8.waruna-group.co.id/webhook/audit-dokumen" required>
                </div>

                <div class="pt-4">
                    <button type="submit" id="submitBtn" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                        Jalankan Audit
                    </button>
                </div>
            </form>

            <!-- Area Hasil Output -->
            <div id="resultContainer" class="mt-8 hidden">
                <h2 class="text-lg font-medium text-gray-900 mb-2">Hasil Temuan Audit:</h2>
                <div class="bg-gray-900 rounded-md p-4 overflow-auto">
                    <pre id="outputResult" class="text-sm text-green-400 font-mono"></pre>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('file_sertifikat').addEventListener('change', function(e) {
            document.getElementById('name_sertifikat').textContent = e.target.files[0] ? e.target.files[0].name : "Belum ada file dipilih";
        });
        document.getElementById('file_penawaran').addEventListener('change', function(e) {
            document.getElementById('name_penawaran').textContent = e.target.files[0] ? e.target.files[0].name : "Belum ada file dipilih";
        });

        document.getElementById('auditForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const btn = document.getElementById('submitBtn');
            const resultContainer = document.getElementById('resultContainer');
            const outputResult = document.getElementById('outputResult');
            const webhookUrl = document.getElementById('webhook_url').value;
            
            const formData = new FormData();
            formData.append('sertifikat', document.getElementById('file_sertifikat').files[0]);
            formData.append('penawaran', document.getElementById('file_penawaran').files[0]);

            btn.disabled = true;
            btn.textContent = 'Memproses dokumen...';
            resultContainer.classList.add('hidden');

            try {
                const response = await fetch(webhookUrl, {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                
                const data = await response.json();
                
                outputResult.textContent = JSON.stringify(data, null, 2);
                outputResult.classList.remove('text-red-400');
                outputResult.classList.add('text-green-400');
                resultContainer.classList.remove('hidden');
                
            } catch (error) {
                outputResult.textContent = 'Terjadi kesalahan sistem atau n8n gagal merespon:\n' + error.message;
                outputResult.classList.replace('text-green-400', 'text-red-400');
                resultContainer.classList.remove('hidden');
            } finally {
                btn.disabled = false;
                btn.textContent = 'Jalankan Audit';
            }
        });
    </script>
</body>
</html>
